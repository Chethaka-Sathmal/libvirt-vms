<!--
  NAT network template: virtual machines can reach each other, the host and the internet.

  Placeholders (fill with envsubst):
    ${NET_NAME}    network name, e.g. blog-001
    ${BRIDGE}      host bridge name, max 15 characters, must be unused, e.g. virbr-b001
    ${NET_PREFIX}  first three octets of the subnet, e.g. 192.168.110

  Render:
    export NET_NAME=blog-001 BRIDGE=virbr-b001 NET_PREFIX=192.168.110
    envsubst '${NET_NAME} ${BRIDGE} ${NET_PREFIX}' < network-nat.xml > $NET_NAME.xml
-->
<network>
  <name>${NET_NAME}</name>

  <!-- Outbound traffic is translated to the host's address. Remove this line for an isolated network. -->
  <forward mode='nat'/>

  <bridge name='${BRIDGE}' stp='on' delay='0'/>

  <!-- Machines on this network can reach each other by name, e.g. vm1.blog-001.lab -->
  <domain name='${NET_NAME}.lab' localOnly='yes'/>

  <!-- The host's address on this network; machines use it as gateway and DNS server -->
  <ip address='${NET_PREFIX}.1' netmask='255.255.255.0'>
    <dhcp>
      <range start='${NET_PREFIX}.100' end='${NET_PREFIX}.200'/>
    </dhcp>
  </ip>
</network>
